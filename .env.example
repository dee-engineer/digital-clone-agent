# --- Gemini ---
GEMINI_API_KEY=
CHAT_MODEL=gemini-2.5-flash
EMBED_MODEL=gemini-embedding-001

# --- Agent service ---
# generate: python -c "import secrets;print(secrets.token_urlsafe(32))"
API_KEY=
# Only for the Gmail automation (docker compose --profile automation). Set to http://n8n:5678/webhook/send-reply
# so approved email replies are sent by n8n. Leave empty to just return the text.
SEND_WEBHOOK_URL=
SEND_WEBHOOK_SECRET=

# --- n8n ---
N8N_ENCRYPTION_KEY=
