{
  "name": "Clone: email triage",
  "nodes": [
    {
      "parameters": {
        "pollTimes": { "item": [{ "mode": "everyMinute" }] },
        "simple": true,
        "filters": { "labelIds": ["INBOX"], "readStatus": "unread" }
      },
      "name": "Gmail Trigger",
      "type": "n8n-nodes-base.gmailTrigger",
      "typeVersion": 1.2,
      "position": [200, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://agent:8000/triage",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ sender: $json.From, subject: $json.Subject, body: $json.snippet, message_id: $json.id }) }}"
      },
      "name": "Send to clone agent",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [460, 300]
    }
  ],
  "connections": {
    "Gmail Trigger": { "main": [[{ "node": "Send to clone agent", "type": "main", "index": 0 }]] }
  },
  "settings": {}
}
